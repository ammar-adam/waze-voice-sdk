# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.venv-tts/
venv/
env/

# Local environment
.env
.env.*

# Generated and rights-sensitive media
audio/raw/*
audio/extracted/*
audio/processed/*
audio/synthesized/*
audio/master/*
audio/export/*
!audio/raw/.gitkeep
!audio/extracted/.gitkeep
!audio/processed/.gitkeep
!audio/synthesized/.gitkeep
!audio/master/.gitkeep
!audio/export/.gitkeep

# Common audio and video artifacts
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.ogg
*.mp4
*.mov
*.mkv
*.avi

# Datasets and model artifacts
datasets/
models/
checkpoints/
runs/
*.ckpt
*.pth
*.pt
*.onnx
*.safetensors

# Local media inputs
media/
source-media/

# OS/editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Voice packs. Each holds paths to your own media and the audio built from
# it, so the whole directory stays out of Git. The README explaining the layout
# is the one exception.
packs/*
!packs/README.md

# Pipeline working state (generated, machine-specific)
audio/.work/
audio/build-manifest.json
audio/qa-report.json

# Local acknowledgement receipt written by the synthesis step
.voice-consent

# Local voice auditions: throwaway mp3s for picking a base voice by ear.
voice-auditions/

# Film cut audio. Derived from packs; regenerate with scripts/build_film_audio.py
film-audio/

# Generated from site/voices.json by scripts/build_site.py, locally and in CI.
site/qr/

# The site's preview clips are the one place audio belongs in the repo: Pages
# serves them, and they are cut from packs that are not committed.
!site/audio/*.mp3
